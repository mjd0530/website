---
/**
 * An image slot on a rounded neutral tile. With `src` it renders an optimized
 * <Image>; without it, a labelled placeholder so layouts can be built before
 * assets arrive. Placeholders are announced as "Image placeholder: <alt>".
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  /** Short text shown on the placeholder tile (defaults to alt) */
  label?: string;
  /** CSS aspect-ratio, e.g. "16 / 9" */
  ratio?: string;
  /** Responsive sizes hint for the browser */
  sizes?: string;
  /** Above the fold: load eagerly */
  priority?: boolean;
  /** Render as decorative (inside a link that already has a name) */
  decorative?: boolean;
  class?: string;
}

const {
  src,
  alt,
  label,
  ratio = '16 / 9',
  sizes = '(min-width: 64em) 60vw, 100vw',
  priority = false,
  decorative = false,
  class: className,
} = Astro.props;
---

<div class:list={['media', className]} style={`--ratio: ${ratio}`}>
  {src ? (
    <Image
      src={src}
      alt={decorative ? '' : alt}
      sizes={sizes}
      widths={[480, 800, 1200, 1600, 2000]}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
    />
  ) : (
    <div
      class="placeholder"
      role={decorative ? undefined : 'img'}
      aria-label={decorative ? undefined : `Image placeholder: ${alt}`}
      aria-hidden={decorative ? 'true' : undefined}
    >
      <span>{label ?? alt}</span>
    </div>
  )}
</div>

<style>
  .media {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-5);
    text-align: center;
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 14px,
      var(--color-surface) 14px 15px
    );
  }

  .placeholder span {
    max-width: 30ch;
    font-size: var(--text-small);
    line-height: var(--leading-ui);
    color: var(--color-text-muted);
  }
</style>
