---
/**
 * An image slot on a rounded tile.
 * - With `src`: the image fills the card edge to edge (cropped to `ratio`).
 *   Unless decorative or `zoom={false}`, the card is a button that opens the
 *   full image in the shared Lightbox, and shows `label` as a hover/focus tooltip.
 * - Without `src`: a labelled placeholder so layouts work before assets arrive,
 *   announced as "Image placeholder: <alt>".
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  /** Full description for screen readers */
  alt: string;
  /** Short descriptor: tooltip, lightbox caption, placeholder text */
  label?: string;
  /** CSS aspect-ratio of the card, e.g. "16 / 9"; "auto" = the image's own shape (no crop) */
  ratio?: string;
  /** Responsive sizes hint for the browser */
  sizes?: string;
  /** Above the fold: load eagerly */
  priority?: boolean;
  /** Render as decorative (inside a link that already has a name); never zoomable */
  decorative?: boolean;
  /** Open in the full-screen viewer on click (default true when there is an image) */
  zoom?: boolean;
  class?: string;
}

const {
  src,
  alt,
  label,
  ratio = '16 / 9',
  sizes = '(min-width: 64em) 60vw, 100vw',
  priority = false,
  decorative = false,
  zoom = true,
  class: className,
} = Astro.props;

const cardRatio = ratio === 'auto' ? (src ? `${src.width} / ${src.height}` : '3 / 1') : ratio;
const zoomable = !!src && !decorative && zoom;
const full = zoomable
  ? await getImage({ src: src!, width: Math.min(src!.width, 3200), format: 'webp' })
  : null;
const tip = label ?? undefined;
---

{zoomable ? (
  <button
    type="button"
    class:list={['media', 'zoomable', className]}
    style={`--ratio: ${cardRatio}`}
    data-lightbox
    data-full={full!.src}
    data-alt={alt}
    data-label={label ?? ''}
    data-width={full!.attributes.width ?? src!.width}
    data-height={full!.attributes.height ?? src!.height}
  >
    <Image
      src={src!}
      alt={alt}
      sizes={sizes}
      widths={[480, 800, 1200, 1600, 2000]}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
    />
    <span class="visually-hidden">, open full screen</span>
    {tip && (
      <span class="tip" aria-hidden="true">
        {tip}
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M9.5 2.5h4v4M13.5 2.5 9 7M6.5 13.5h-4v-4M2.5 13.5 7 9" />
        </svg>
      </span>
    )}
  </button>
) : (
  <div class:list={['media', className]} style={`--ratio: ${cardRatio}`}>
    {src ? (
      <Image
        src={src}
        alt={decorative ? '' : alt}
        sizes={sizes}
        widths={[480, 800, 1200, 1600, 2000]}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
      />
    ) : (
      <div
        class="placeholder"
        role={decorative ? undefined : 'img'}
        aria-label={decorative ? undefined : `Image placeholder: ${alt}`}
        aria-hidden={decorative ? 'true' : undefined}
      >
        <span>{label ?? alt}</span>
      </div>
    )}
  </div>
)}

<style>
  .media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    padding: 0;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
  }

  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Zoomable card */
  .zoomable {
    cursor: zoom-in;
    font: inherit;
    color: inherit;
    text-align: start;
  }

  .zoomable :global(img) {
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .zoomable:hover :global(img) {
    transform: scale(1.015);
  }

  :global([data-theme='contrast']) .zoomable {
    border-width: 2px;
    border-color: var(--color-border);
  }

  /* Tooltip: short descriptor, on hover and keyboard focus. Escape hides it (Lightbox script). */
  .tip {
    position: absolute;
    inset-inline-start: var(--space-3);
    inset-block-end: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    max-width: calc(100% - var(--space-6));
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-label);
    line-height: var(--leading-ui);
    color: var(--color-text);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .tip svg {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global([data-theme='contrast']) .tip {
    border-color: var(--color-border);
  }

  .zoomable:hover .tip,
  .zoomable:focus-visible .tip {
    opacity: 1;
    transform: none;
  }

  .zoomable[data-tip-dismissed] .tip {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .zoomable:hover :global(img) {
      transform: none;
    }
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: var(--space-5);
    text-align: center;
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 14px,
      var(--color-surface) 14px 15px
    );
  }

  .placeholder span {
    max-width: 30ch;
    font-size: var(--text-small);
    line-height: var(--leading-ui);
    color: var(--color-text-muted);
  }
</style>
