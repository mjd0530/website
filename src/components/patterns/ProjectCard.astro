---
/**
 * Work grid card: the cover art fills a rounded tile and the whole card is one
 * link (on home it jumps to the project's spotlight; any href works). Cover art is expected to carry the project name visually
 * (as in the reference); the title is still in the markup for screen readers.
 */
import Media from '../primitives/Media.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  client: string;
  cover: { src?: ImageMetadata; alt: string; label?: string };
  headingLevel?: 'h2' | 'h3';
  priority?: boolean;
}

const { href, title, client, cover, headingLevel = 'h3', priority = false } = Astro.props;
const Heading = headingLevel;
---

<article class="card">
  <a href={href}>
    <Heading class="visually-hidden">{title}</Heading>
    <span class="visually-hidden">{client}</span>
    <Media
      {...cover}
      label={cover.src ? undefined : `${title}, cover`}
      decorative
      ratio="458 / 258"
      sizes="(min-width: 64em) 30vw, (min-width: 40em) 50vw, 100vw"
      priority={priority}
    />
  </a>
</article>

<style>
  a {
    display: block;
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
  }

  a :global(.media) {
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  a:hover :global(.media) {
    transform: translateY(-2px);
    border-color: var(--color-border);
  }

  :global([data-theme='contrast']) a :global(.media) {
    border-width: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    a:hover :global(.media) {
      transform: none;
    }
  }
</style>
