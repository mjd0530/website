---
/**
 * Link to MDOS, the retro-desktop version of the portfolio. The icon is the
 * MDOS "computer" icon (Black & White look), copied from mdos/src/assets/icons/icons.ts
 * and drawn as pixel runs so it stays crisp at 32px.
 */
import { mdosUrl } from '../../data/site';

// Matches the version in mdos/package.json; update when MDOS ships a new one.
const version = '0.1.0';
const tooltip = `MDOS\nVersion ${version}\n\nA portfolio by Mike DeMar, as a desktop computer you can explore.`;

const PALETTE: Record<string, string> = {
  '#': '#000000',
  o: '#ffffff',
  '+': '#888888',
};

// One character per pixel; ' ' is transparent.
const rows = [
  '    ########################    ',
  '    #oooooooooooooooooooooo#    ',
  '    #oooooooooooooooooooooo#    ',
  '    #oo##################oo#    ',
  '    #oo#++++++++++++++++#oo#    ',
  '    #oo#++++++++++++++++#oo#    ',
  '    #oo#+#++++++++++++++#oo#    ',
  '    #oo#++#+++++++++++++#oo#    ',
  '    #oo#+++#++++++++++++#oo#    ',
  '    #oo#++#+++++++++++++#oo#    ',
  '    #oo#+#+++####+++++++#oo#    ',
  '    #oo#++++++++++++++++#oo#    ',
  '    #oo#++++++++++++++++#oo#    ',
  '    #oo#++++++++++++++++#oo#    ',
  '    #oo#++++++++++++++++#oo#    ',
  '    #oo##################oo#    ',
  '    #oooooooooooooooooooooo#    ',
  '    #oooooooooooooooooooooo#    ',
  '    #oooooooooooooooooooooo#    ',
  '    ########################    ',
  '             #oooo#             ',
  '             ######             ',
  '   ##########################   ',
  '   #oooooooooooooooooooooooo#   ',
  '   #o#o#o#o#o#o#o#o#o#o#o#oo#   ',
  '   #o#o#o#o#o#o#o#o#o#o#o#oo#   ',
  '   #oooooooooooooooooooooooo#   ',
  '   ##########################   ',
];

const width = rows[0]!.length;
const height = rows.length;

// Merge horizontal runs of one colour so the SVG has few rects.
const runs: { x: number; y: number; w: number; fill: string }[] = [];
rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const ch = row[x]!;
    let end = x + 1;
    while (end < row.length && row[end] === ch) end++;
    if (ch !== ' ') runs.push({ x, y, w: end - x, fill: PALETTE[ch]! });
    x = end;
  }
});
---

<a class="mdos-link" href={mdosUrl} title={tooltip}>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    width={width}
    height={height}
    shape-rendering="crispEdges"
    aria-hidden="true"
  >
    {runs.map((r) => (
      <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />
    ))}
  </svg>
  <span class="visually-hidden">
    MDOS: a portfolio by Mike DeMar, as a desktop computer you can explore
  </span>
</a>

<style>
  .mdos-link {
    display: inline-grid;
    place-items: center;
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    margin-inline-end: calc(var(--space-2) * -1);
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .mdos-link:hover {
    border-color: var(--color-border);
  }

  svg {
    display: block;
    width: 28px;
    height: auto;
    image-rendering: pixelated;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mdos-link:hover svg {
      animation: mdos-blink 0.6s steps(1) 1;
    }
  }

  @keyframes mdos-blink {
    50% {
      transform: translateY(-1px);
    }
  }
</style>
