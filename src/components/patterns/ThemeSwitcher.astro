---
/**
 * Theme switcher: a disclosure button that opens a labelled radio group
 * (Light / Dark / High contrast). The choice is applied to <html data-theme>
 * and saved to localStorage; BaseLayout's inline script restores it before paint.
 * Hidden until JS runs, since without JS the theme cannot change.
 */
const options = [
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
  { value: 'contrast', label: 'High contrast' },
] as const;
---

<div class="theme-switcher" data-theme-switcher hidden>
  <button
    type="button"
    class="trigger"
    aria-expanded="false"
    aria-controls="theme-panel"
    aria-label="Theme"
    data-trigger
  >
    <svg class="icon icon-light" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
    </svg>
    <svg class="icon icon-dark" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
    </svg>
    <svg class="icon icon-contrast" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="8.5"></circle>
      <path d="M12 3.5v17a8.5 8.5 0 0 0 0-17Z" class="fill"></path>
    </svg>
    <span class="trigger-label" aria-hidden="true">
      Theme
    </span>
  </button>

  <div class="panel" id="theme-panel" hidden data-panel>
    <fieldset>
      <legend>Theme</legend>
      {options.map((o) => (
        <label>
          <input type="radio" name="theme" value={o.value} />
          {o.label}
        </label>
      ))}
    </fieldset>
  </div>
</div>

<script>
  type Theme = 'light' | 'dark' | 'contrast';
  const names: Record<Theme, string> = { light: 'Light', dark: 'Dark', contrast: 'High contrast' };

  const root = document.querySelector<HTMLElement>('[data-theme-switcher]');
  if (root) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-trigger]')!;
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[name="theme"]')];
    const html = document.documentElement;

    const current = () => (html.dataset.theme as Theme) ?? 'light';

    const sync = () => {
      const theme = current();
      trigger.setAttribute('aria-label', `Theme: ${names[theme]}`);
      for (const r of radios) r.checked = r.value === theme;
    };

    const setOpen = (open: boolean, returnFocus = false) => {
      panel.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
      if (open) radios.find((r) => r.checked)?.focus();
      else if (returnFocus) trigger.focus();
    };

    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';

    trigger.addEventListener('click', () => setOpen(!isOpen()));

    for (const r of radios) {
      r.addEventListener('change', () => {
        html.dataset.theme = r.value;
        try {
          localStorage.setItem('theme', r.value);
        } catch {
          // Storage blocked: the theme still applies for this page view.
        }
        sync();
      });
    }

    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        e.preventDefault();
        setOpen(false, true);
      }
    });

    // Close when focus or a click leaves the switcher.
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) setOpen(false);
    });
    document.addEventListener('pointerdown', (e) => {
      if (isOpen() && !root.contains(e.target as Node)) setOpen(false);
    });

    sync();
    root.hidden = false;
  }
</script>

<style>
  .theme-switcher {
    position: relative;
  }

  .trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    padding-inline: var(--space-3);
    margin-inline-end: calc(var(--space-3) * -1);
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
    color: var(--color-text);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .trigger:hover,
  .trigger[aria-expanded='true'] {
    border-color: var(--color-border);
  }

  :global([data-theme='contrast']) .trigger {
    border-color: var(--color-border);
  }

  .icon {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    display: none;
  }

  .icon .fill {
    fill: currentColor;
    stroke: none;
  }

  :global([data-theme='light']) .icon-light,
  :global([data-theme='dark']) .icon-dark,
  :global([data-theme='contrast']) .icon-contrast {
    display: block;
  }

  /* Icon-only on small screens; the accessible name stays "Theme: …" */
  @media (max-width: 39.99em) {
    .trigger-label {
      display: none;
    }
  }

  .panel {
    position: absolute;
    inset-block-start: calc(100% + var(--space-2));
    inset-inline-end: calc(var(--space-3) * -1);
    z-index: 50;
    min-width: 13rem;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    opacity: 1;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  @starting-style {
    .panel {
      opacity: 0;
    }
  }

  :global([data-theme='contrast']) .panel {
    border: 2px solid var(--color-border);
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }

  legend {
    padding: 0;
    margin-block-end: var(--space-1);
    font-size: var(--text-label);
    color: var(--color-text-muted);
  }

  label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-target);
    font-size: var(--text-ui);
    cursor: pointer;
  }

  /* Token-driven radio so the ring meets 3:1 in every theme (native dark radios don't) */
  input[type='radio'] {
    appearance: none;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface-raised);
    transition: box-shadow var(--duration-fast) var(--ease-out);
  }

  input[type='radio']:checked {
    border-color: var(--color-accent);
    box-shadow: inset 0 0 0 0.2rem var(--color-surface-raised);
    background: var(--color-accent);
  }

  @media (forced-colors: active) {
    input[type='radio'] {
      appearance: auto;
    }
  }
</style>
