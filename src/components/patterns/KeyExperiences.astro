---
/**
 * Key user experiences: a short title and one line each, laid out as a grid.
 * Used in a case study body, under the section that defines the experience.
 */
interface Props {
  items: { title: string; text: string }[];
  label?: string;
}

const { items, label = 'Key user experiences' } = Astro.props;
---

<section class="experiences" aria-label={label}>
  <ul>
    {items.map((x) => (
      <li>
        <h4>{x.title}</h4>
        <p>{x.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Same card language as StatGrid: display-face title, one muted line */
  .experiences ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9.5rem, 100%), 1fr));
    gap: var(--card-gap);
    padding: 0;
    list-style: none;
  }

  /* Phones fit two cards a row: an odd last card spans the row */
  @media (max-width: 39.99em) {
    .experiences li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .experiences li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
  }

  :global([data-theme='contrast']) .experiences li {
    border: 2px solid var(--color-border);
  }

  .experiences h4 {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
  }

  .experiences p {
    font-size: var(--text-small);
    line-height: var(--leading-ui);
    color: var(--color-text-muted);
  }
</style>
