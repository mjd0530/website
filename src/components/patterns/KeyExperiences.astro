---
/**
 * Key user experiences: a short title and one line each, laid out as a grid.
 * Used in a case study body, under the section that defines the experience.
 */
interface Props {
  items: { title: string; text: string }[];
  label?: string;
}

const { items, label = 'Key user experiences' } = Astro.props;
---

<section class="experiences" aria-label={label}>
  <ul>
    {items.map((x) => (
      <li>
        <h4>{x.title}</h4>
        <p>{x.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .experiences ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-5) var(--space-7);
    padding: 0;
    list-style: none;
  }

  .experiences h4 {
    font-family: var(--font-text);
    font-size: var(--text-body);
    font-weight: 600;
    line-height: var(--leading-ui);
    letter-spacing: normal;
  }

  .experiences p {
    margin-block-start: var(--space-1);
    font-size: var(--text-ui);
    line-height: var(--leading-body);
    color: var(--color-text-muted);
  }
</style>
