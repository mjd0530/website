---
/**
 * Two-column image grid (Delivery). One column on mobile.
 * With an odd number of images, the last one spans both columns so the grid
 * never ends on a lone half-width card.
 */
import Media from '../primitives/Media.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src?: ImageMetadata; alt: string; label?: string }[];
  ratio?: string;
}

const { items, ratio = '458 / 258' } = Astro.props;
const lastIsWide = items.length % 2 === 1 && items.length > 1;
---

<div class="media-grid">
  {items.map((item, i) => {
    const wide = lastIsWide && i === items.length - 1;
    return (
      <div class:list={['cell', { wide }]}>
        <Media
          {...item}
          ratio={ratio}
          sizes={
            wide
              ? '(min-width: 64em) 66vw, 100vw'
              : '(min-width: 64em) 32vw, (min-width: 40em) 50vw, 100vw'
          }
        />
      </div>
    );
  })}
</div>

<style>
  .media-grid {
    display: grid;
    gap: var(--card-gap);
  }

  .cell {
    min-width: 0;
  }

  @media (min-width: 40em) {
    .media-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .wide {
      grid-column: 1 / -1;
    }
  }
</style>
