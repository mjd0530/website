---
/** Two-column image grid (Delivery). One column on mobile. */
import Media from '../primitives/Media.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src?: ImageMetadata; alt: string; label?: string }[];
  ratio?: string;
}

const { items, ratio = '458 / 258' } = Astro.props;
---

<div class="media-grid">
  {items.map((item) => (
    <Media {...item} ratio={ratio} sizes="(min-width: 64em) 32vw, (min-width: 40em) 50vw, 100vw" />
  ))}
</div>

<style>
  .media-grid {
    display: grid;
    gap: var(--card-gap);
  }

  @media (min-width: 40em) {
    .media-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
